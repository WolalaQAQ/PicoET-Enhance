{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PicoET PC Studio",
  "version": "2.6.2",
  "identifier": "dev.pico.etenhance.pcstudio",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "PicoET PC Studio",
        "width": 1160,
        "height": 820,
        "minWidth": 820,
        "minHeight": 620,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
