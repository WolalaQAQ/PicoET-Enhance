# Best-effort SEPolicy rules for an enforcing build. The supported device runs permissive,
# so these rules have not been exercised yet. The injector runs as root in the magisk
# domain; the payload runs inside pxreyetrackingservice and reads /data/local/tmp files
# (shell_data_file). The PICO libraries are system_lib_file; our injected library lives in
# the module directory (system_file).

# ptrace injection: magisk (su / service.sh) -> pxreyetrackingservice
allow magisk pxreyetrackingservice:process ptrace;
allow magisk pxreyetrackingservice:process signal;
allow magisk pxreyetrackingservice:mem read;
allow magisk pxreyetrackingservice:mem write;
allow magisk pxreyetrackingservice:fd use;

# payload inside the target: mode/gate files + log in /data/local/tmp
allow pxreyetrackingservice shell_data_file:dir { search read open getattr write add_name remove_name };
allow pxreyetrackingservice shell_data_file:file { open read write create append getattr rename unlink };

# payload: map/execute our own injected library (module dir -> system_file)
allow pxreyetrackingservice system_file:file { open read execute execute_no_trans map };

# runtime code patching of the plugin: mprotect RWX / COW-exec (execmod)
allow pxreyetrackingservice system_lib_file:file execmod;
allow pxreyetrackingservice self:process execmem;
